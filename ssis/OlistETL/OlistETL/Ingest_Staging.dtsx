// Script Task "SCR Check <bang>" - Task 2 / Ingest_Staging.dtsx
// Dán toàn bộ nội dung này vào cửa sổ Edit Script của Script Task.
// ReadOnlyVariables : User::var_raw_dir, User::current_file, User::current_table
