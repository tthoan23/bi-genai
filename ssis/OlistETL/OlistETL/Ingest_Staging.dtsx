        <DTS:Executable
          DTS:refId="Package\SEQ_order_reviews\ST_Sha_order_reviews"
          DTS:CreationName="Microsoft.ScriptTask"
          DTS:Description="SSIS Script Task"
          DTS:DTSID="{8BD9096C-7BE7-5CA0-BC94-0BC812B20BBC}"
          DTS:ExecutableType="Microsoft.ScriptTask"
          DTS:LocaleID="-1"
          DTS:MaxErrorCount="0"
          DTS:ObjectName="ST_Sha_order_reviews"
