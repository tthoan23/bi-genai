          SQLTask:SqlStatementSource="UPDATE dwh.dim_customer SET dw_created_at = SYSDATETIME(), dw_updated_at = COALESCE(dw_updated_at, SYSDATETIME()) WHERE dw_created_at IS NULL; UPDATE dwh.dim_seller SET dw_created_at = SYSDATETIME(), dw_updated_at = COALESCE(dw_updated_at, SYSDATETIME()) WHERE dw_created_at IS NULL; UPDATE dwh.dim_product SET dw_created_at = SYSDATETIME(), dw_updated_at = COALESCE(dw_updated_at, SYSDATETIME()) WHERE dw_created_at IS NULL; UPDATE dwh.dim_geography SET dw_created_at = SYSDATETIME(), dw_updated_at = COALESCE(dw_updated_at, SYSDATETIME()) WHERE dw_created_at IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
